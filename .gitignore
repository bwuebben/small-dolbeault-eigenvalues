# Public release allowlist; build products and unlisted files stay local.
*
!/.gitignore
!/README.md
!/LICENSE
!/CITATION.cff
!/CITATION.bib
!/Makefile
!/SHA256.json
!/.github/
!/.github/workflows/
!/.github/workflows/verify.yml
!/paper/
!/paper/README.md
!/paper/*.tex
!/paper/small-dolbeault-eigenvalues.pdf
!/checks/
!/checks/README.md
!/checks/check_*.py
!/paper3/
!/paper3/README.md
!/paper3/LICENSE
!/paper3/SHA256.json
!/paper3/CITATION.cff
!/paper3/CITATION.bib
!/paper3/paper/
!/paper3/paper/*.tex
!/paper3/paper/main.pdf
!/paper3/paper/README.md
!/paper3/checks/
!/paper3/checks/check_rank_matrix.py
!/paper3/checks/README.md
